x=0;entryDy=0;" edge="1" parent="1" source="n14" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="Cycle loss  λcycle = 10&#xa;|x - x̂| + |y - ŷ_c|" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#333333;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="295" width="220" height="60" as="geometry"/></mxCell><mxCell id="n26" value="" style="endArrow=block;endFill=1;html=0;strokeColor=#333333;fontSize=10;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="endArrow=block;endFill=1;html=0;strokeColor=#333333;fontSize=10;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="Identity loss  λid = 5&#xa;G S to W(y) close to y,&#xa;G W to S(x) close to x" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eeeeee;strokeColor=#333333;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="510" width="220" height="70" as="geometry"/></mxCell><mxCell id="n29" value="Adversarial loss (LSGAN)&#xa;mean squared error to real / fake labels" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eeeeee;strokeColor=#333333;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="50" width="220" height="60" as="geometry"/></mxCell><mxCell id="n30" value="Physics losses on generated windows (see physics diagram)&#xa;SOC to current  0.4&#xa;velocity to acceleration  0.03&#xa;plausibility range  5.0" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#333333;fontSize=12;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="370" height="110" as="geometry"/></mxCell><mxCell id="n31" value="" style="endArrow=block;endFill=1;html=0;strokeColor=#333333;fontSize=10;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="" style="endArrow=block;endFill=1;html=0;strokeColor=#333333;fontSize=10;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="Generator layout: Conv 7 (64 filters) &gt; 3 stride-2 conv &gt; 6 ResNet blocks &gt; 3 transposed conv &gt; Conv 7 + tanh; discriminator: 1D PatchGAN, 5 conv layers.   Total generator loss = adversarial + 10 x cycle + 5 x identity + physics terms.   Adam, lr 2e-4, beta1 0.5, batch 256, 100 epochs.   E2 uses the same network with all three physics weights set to 0." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1200" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>